# Remote: Supabase dashboard > Project Settings > API
# Local: run `pnpm db:start` (requires Docker), then `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional, for applying migrations from this checkout.
# Keep these in a gitignored .env or .env.local, never in NEXT_PUBLIC_* variables.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

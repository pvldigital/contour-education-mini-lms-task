# Supabase API credentials.
# Remote: Supabase dashboard > Project Settings > API.
# Local: run `pnpm db:local:start`, then `pnpm exec supabase status` and copy the
# API URL and publishable/anon key printed there.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional, for applying migrations from this checkout.
# Keep these gitignored; never expose them through NEXT_PUBLIC_* variables.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
